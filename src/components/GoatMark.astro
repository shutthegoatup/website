---
interface Props {
  readonly class?: string;
  readonly bar?: string;
  /** Knockout colour for the pupils — match the ground the mark sits on. */
  readonly eye?: string;
  readonly title?: string;
}

const {
  class: className,
  bar = "var(--color-signal)",
  eye = "var(--color-bone)",
  title,
} = Astro.props;
---

<svg
  viewBox="0 0 100 100"
  class={className}
  fill="none"
  role={title ? "img" : "presentation"}
  aria-label={title}
  aria-hidden={title ? undefined : "true"}
>
  <g stroke="currentColor" stroke-width="9" stroke-linecap="round">
    <path d="M39 29 C32 17 25 8 13 6"></path>
    <path d="M61 29 C68 17 75 8 87 6"></path>
  </g>
  <g fill="currentColor">
    <path d="M35 45 C27 43 16 46 10 53 C17 57 28 56 35 51 Z"></path>
    <path d="M65 45 C73 43 84 46 90 53 C83 57 72 56 65 51 Z"></path>
    <path
      d="M33 26 H67 L65 46 C65 58 61 68 56 74 C55 82 55 88 51 91 Q50 92 49 91 C45 88 45 82 44 74 C39 68 35 58 35 46 Z"
    ></path>
  </g>
  <g fill={eye}>
    <rect x="39" y="42" width="8" height="4" rx="1.2"></rect>
    <rect x="53" y="42" width="8" height="4" rx="1.2"></rect>
  </g>
  <rect x="24" y="60" width="52" height="11" fill={bar}></rect>
</svg>
