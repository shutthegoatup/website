---
import { capabilities } from "~/lib/site";
---

<section class="border-b-2 border-ink">
  <div class="mx-auto max-w-[110rem] px-4 py-20 sm:px-6 lg:px-10 lg:py-28">
    <div class="reveal grid gap-8 lg:grid-cols-[1fr_1.1fr] lg:items-end">
      <div>
        <p class="stamp text-ash-deep">§ 03 — Engineering</p>
        <h2 class="display mt-4 text-[clamp(2.5rem,7vw,6rem)]">
          How we<br />build
        </h2>
      </div>
      <p class="max-w-xl text-lg leading-relaxed text-ink/75">
        No delivery managers, no bench, no pyramid. Four disciplines, one team,
        and the people who write the code are the ones carrying the pager for
        it.
      </p>
    </div>

    <ul class="mt-16 grid gap-px border-2 border-ink bg-ink sm:grid-cols-2">
      {
        capabilities.map((capability, i) => (
          <li
            class="reveal bg-bone p-8 lg:p-12"
            style={`transition-delay:${i * 90}ms`}
          >
            <p class="stamp text-ash-deep">{capability.index}</p>
            <h3 class="display mt-6 text-3xl lg:text-4xl">
              {capability.title}
            </h3>
            <p class="mt-4 max-w-md text-base leading-relaxed text-ink/75">
              {capability.body}
            </p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
