---
import { site } from "~/lib/site";
---

<section class="bg-signal text-bone">
  <div class="mx-auto max-w-[110rem] px-4 py-24 sm:px-6 lg:px-10 lg:py-36">
    <p class="reveal stamp text-bone/70">§ 05 — Start something</p>
    <h2 class="reveal display mt-6 text-[clamp(2.8rem,10vw,9rem)] text-balance">
      Point us at<br />your
      <span class="font-prestige normal-case italic">Goat</span>.
    </h2>
    <p class="reveal mt-10 max-w-2xl text-xl leading-snug sm:text-2xl">
      Tell us which incumbent is taxing your business, or which product you have
      not been able to get built. We will tell you honestly whether we are the
      right people for it.
    </p>
    <a
      href={`mailto:${site.email}`}
      class="reveal display mt-12 inline-block border-2 border-bone px-8 py-6 text-2xl transition-colors hover:bg-bone hover:text-signal sm:text-4xl lg:text-5xl"
    >
      {site.email}
    </a>
  </div>
</section>
